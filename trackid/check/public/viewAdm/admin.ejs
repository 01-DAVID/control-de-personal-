<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/admin.css">
    <title>Panel Administrador</title>
</head>
<body>
    <div class="contenedor">
        <aside class="barra-lateral" aria-label="Menu lateral">
            <h2 class="titulo-barra"></h2>
            <button id="cerrar-sesion" type="button" class="boton-lateral">Cerrar sesion</button>
            <a href="/personal" class="boton-lateral">Informes </a>
            <a href="/perfiles" class="boton-lateral"> Crear perfiles</a>
            <a href="/personal_activo" class="boton-lateral">Actualizar Datos</a>
            <a href="/personal_inactivo" class="boton-lateral">Dar salida</a>
        </aside>

        <div class=" content">
            <main class="tarjeta">
                <h1>Administrador</h1>
                <p>Usa el menu lateral para consultar el personal registrado, el personal activo en sede y el personal que ya salio.</p>
            </main>

            <main class="presentacion ">
                <div class="cuadro">
                    <div class="perfil-usuario">
                        <h1>Bienvenido/a <span class="nombre"></span></h1>
                        <div class="foto-container">
                            <img class="foto-usuario" src="" alt="Foto del usuario">
                            <span class="foto-placeholder">Sin foto</span>
                        </div>
                    </div>
                </div>
            </main>
        </div>


        

        
        
        
    <script src="/js/admin.js"></script>
    
</body>
</html>
